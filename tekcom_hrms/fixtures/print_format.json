  "font": null,
  "font_size": 14,
  "format_data": null,
  "html": "<table style=\"width: 100%; border-collapse: collapse;\" border=1>\n    <tbody>\n        <tr>\n            {%- set company = frappe.db.get_value('Employee', doc.grievance_against, 'company') -%}\n            <td rowspan=3 style=\"vertical-align: middle !important; width: 150px; white-space: nowrap;\">\n                {%- if company == \"TECNOLOGIA EN COMUNICACIONES DTH SA DE CV\" -%}\n                <img alt=\"Logo Tek-com\" height=\"\" src=\"/files/Logo-horizontal-230x68-1.png\" style=\"max-width: 90px !important; height: auto !important\">\n                <img alt=\"Membrete DTH\" height=\"\" src=\"/files/DTH_logo.png\" style=\"max-width: 60px !important; height: auto !important;\">\n                {%- else -%}\n                <img alt=\"Logo Tek-com\" height=\"\" src=\"/files/Logo-horizontal-230x68-1.png\" style=\"max-width: 130px !important; height: auto !important\">\n                {%- endif -%}\n            </td>\n            <td rowspan=3 style=\"max-width: 100%; white-space: nowrap; text-align: center; vertical-align: middle !important;\">\n                <h3 style=\"margin: 0 !important;\">MEMORANDO</h3>\n            </td>\n            <td class=\"heading-small\" width=\"90px\">CODIGO</td>\n            <td class=\"heading-small\" width=\"50px\">RH-FO-013</td>\n        </tr>\n        <tr>\n            <td class=\"heading-small\" width=\"90px\">VERSION</td>\n            <td class=\"heading-small\">2</td>\n        </tr>\n        <tr>\n            <td class=\"heading-small\" width=\"90px\">FECHA VERSION</td>\n            <td class=\"heading-small\">01/08/2023</td>\n        </tr>\n    </tbody>\n</table>\n<table style=\"margin-top: 30px;\">\n    <tbody>\n        <tr>\n            {% set grievance_against = frappe.db.get_value(doc.grievance_against_party, doc.grievance_against, 'employee_name') %}\n            <th width=\"25%\">PARA:</th>\n            <td width=\"75%\">{{ grievance_against }}</td>\n        </tr>\n        <tr>\n            {% set grievance_against_designation = frappe.db.get_value(doc.grievance_against_party, doc.grievance_against, 'designation') %}\n            <th width=\"25%\">CARGO:</th>\n            <td width=\"75%\">{{ grievance_against_designation }}</td>\n        </tr>\n    </tbody>\n</table>\n<table style=\"margin-top: 10px;\">\n    <tbody>\n        <tr>\n            <th width=\"25%\">DE:</th>\n            <td width=\"75%\">{{ doc.employee_name }}</td>\n        </tr>\n        <tr>\n            <th width=\"25%\">CARGO:</th>\n            <td width=\"75%\">{{ doc.designation }}</td>\n        </tr>\n    </tbody>\n</table>\n<table style=\"margin-top: 10px;\">\n    <tbody>\n        <tr>\n            <th width=\"25%\">CC:</th>\n            <td width=\"75%\">NICOLE CERRATO</td>\n        </tr>\n        <tr>\n            <th width=\"25%\">CARGO:</th>\n            <td width=\"75%\">GERENTE DE RECURSOS HUMANOS</td>\n        </tr>\n    </tbody>\n</table>\n<table style=\"margin-top: 10px;\">\n    <tbody>\n        <tr>\n            <th width=\"25%\">ASUNTO:</th>\n            <td width=\"75%\">{{ doc.subject }}</td>\n        </tr>\n    </tbody>\n</table>\n<table style=\"margin-top: 10px;\">\n    <tbody>\n        <tr>\n            <th width=\"25%\">FECHA:</th>\n            <td width=\"75%\">{{ frappe.utils.formatdate(doc.date, \"MMMM d, YYYY\") }}</td>\n        </tr>\n    </tbody>\n</table>\n<hr style=\"border: 1px solid black; width: 100%;\">\n<table style=\"margin-top: 20px;\">\n    <tbody>\n        <tr>\n            <td style=\"white-space:pre-line; text-align: justify;\">{{ doc.description }}</td>\n        </tr>\n    </tbody>\n</table>\n<table style=\"margin-top: 10px\">\n    <tr>\n        <td>CC. Archivo</td>\n    </tr>\n</table>",
