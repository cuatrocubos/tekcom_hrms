  "format_data": null,
  "html": "<table style=\"width: 100%; border-collapse: collapse;\" border=0>\n    <tbody>\n        <tr>\n            <td rowspan=3 style=\"vertical-align: middle !important; width: 150px; white-space: nowrap;\">\n                {%- if doc.company == \"TECNOLOGIA EN COMUNICACIONES DTH SA DE CV\" -%}\n                <img alt=\"Logo Tek-com\" height=\"\" src=\"/files/Logo-horizontal-230x68-1.png\" style=\"max-width: 90px !important; height: auto !important\">\n                <img alt=\"Membrete DTH\" height=\"\" src=\"/files/DTH_logo.png\" style=\"max-width: 60px !important; height: auto !important;\">\n                {%- else -%}\n                <img alt=\"Logo Tek-com\" height=\"\" src=\"/files/Logo-horizontal-230x68-1.png\" style=\"max-width: 130px !important; height: auto !important\">\n                {%- endif -%}\n            </td>\n            <td rowspan=3 style=\"max-width: 100%; white-space: nowrap; vertical-align: middle !important;\">\n                <h3 style=\"margin: 0 !important;\">VOUCHER DE PAGO</h3>\n            </td>\n        </tr>\n    </tbody>\n</table>\n<table style=\"margin-top: 30px;\">\n    <tbody>\n        <tr>\n            <th width=\"15%\">Empleado</th>\n            <td width=\"35%\">{{ doc.employee_name }}</td>\n            <th width=\"15%\">Fecha de Pago</th>\n            <td width=\"35%\">{{ doc.posting_date }}</td>\n        </tr>\n    </tbody>\n</table>\n<table style=\"border-collapse: collapse;\">\n    <tr>\n        <td>\n            <table width=\"100%\">\n                <thead>\n                    <tr>\n                        <th colspan=2>Percepciones</th>\n                    </tr>\n                </thead>\n                <tbody>\n                    {% for dd in doc.earnings %}\n                    <tr>\n                        <td width=\"75%\">{{ dd.salary_component }}</td>\n                        <td width=\"25%\" style=\"text-align: right;\">{{ dd.get_formatted(\"amount\", dd) }}</td>\n                    </tr>\n                    {% endfor %}\n                </tbody>\n            </table>\n        </td>\n        <td>\n            <table width=\"100%\">\n                <thead>\n                    <tr>\n                        <th colspan=2>Deducciones</th>\n                    </tr>\n                </thead>\n                <tbody>\n                    {% for dd in doc.deductions %}\n                    {% if dd.do_not_include_in_total == 0 %}\n                    <tr>\n                        <td width=\"75%\">{{ dd.salary_component }}</td>\n                        <td width=\"25%\" style=\"text-align: right;\">{{ dd.get_formatted(\"amount\", dd) }}</td>\n                    </tr>\n                    {% endif %}\n                    {% endfor %}\n                </tbody>\n            </table>\n            <table width=\"100%\">\n                <tbody>\n                    <tr>\n                        <th width=\"25%\">Pago Bruto</th>\n                        <td width=\"75%\" style=\"text-align: right;\">{{ doc.get_formatted(\"base_gross_pay\", doc) }}</td>\n                    </tr>\n                    <tr>\n                        <th width=\"25%\">Total Deducciones</th>\n                        <td width=\"75%\" style=\"text-align: right;\">{{ doc.get_formatted(\"base_total_deduction\", doc) }}</td>\n                    </tr>\n                    <tr>\n                        <th width=\"25%\">Pago Neto</th>\n                        <td width=\"75%\" style=\"text-align: right;\">{{ doc.get_formatted(\"base_net_pay\", doc) }}</td>\n                    </tr>\n                </tbody>\n            </table>\n        </td>\n    </tr>\n</table>\n\n",
